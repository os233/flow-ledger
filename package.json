{
  "name": "flow-ledger",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "流水账：先记下、再整理、可长期保存的个人数字花园",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro sync && astro check",
    "build": "astro sync && astro check && astro build && node scripts/index-search.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check:links": "node scripts/check-links.mjs",
    "check:visibility": "node scripts/check-visibility.mjs",
    "new": "node scripts/new-post.mjs",
    "archive": "node scripts/new-archive.mjs",
    "import": "node scripts/import.mjs",
    "export": "node scripts/export.mjs",
    "fetch:github": "node scripts/fetch-github-data.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.4.1",
    "@tailwindcss/vite": "^4.1.11",
    "astro": "^7.3.7",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "archiver": "^8.0.0",
    "fast-xml-parser": "^5.11.2",
    "iconv-lite": "^0.7.3",
    "marked": "^18.1.0",
    "pagefind": "1.5.2",
    "turndown": "^7.2.4",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true
  }
}
