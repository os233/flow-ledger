---
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE, withBase } from '@/lib/site';

const links = [
  { href: withBase('/'), label: '首页' },
  { href: withBase('/notes/'), label: '灵感' },
  { href: withBase('/archives/'), label: '归档' },
  { href: withBase('/projects/'), label: '项目' },
  { href: withBase('/posts/'), label: '博客' },
  { href: withBase('/about/'), label: '关于' },
];

const path = Astro.url.pathname;
// 生产构建的目录式页面 pathname 无尾斜杠（首页为 /flow-ledger），dev 带尾斜杠；
// 归一化后再比较，两种模式高亮行为一致
const norm = (p: string) => (p.length > 1 ? p.replace(/\/+$/, '') : p);
const isActive = (href: string) =>
  href === withBase('/') ? norm(path) === norm(withBase('/')) : path.startsWith(norm(href));

/** Header / Feed / Card / Article / Footer：与 P3 主题 slot 命名对齐 */
const nav = links.map((l) => ({ ...l, active: isActive(l.href) }));---

<header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6">
    <a
      href={withBase('/')}
      class="flex items-center gap-2 font-bold text-lg text-ink hover:text-accent transition-colors"
      aria-label={`${SITE_TITLE} 首页`}
    >
      <svg class="h-6 w-6 text-accent" viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="14" fill="currentColor" opacity="0.12"></rect>
        <path d="M18 20h28M18 30h22M18 40h26M18 50h14" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"></path>
        <circle cx="48" cy="50" r="5" fill="var(--color-logo-dot)"></circle>
      </svg>
      <span>{SITE_TITLE}</span>
    </a>

    <nav class="hidden md:flex items-center gap-1" aria-label="主导航">
      {nav.map((l) => (
        <a
          href={l.href}
          aria-current={l.active ? 'page' : undefined}
          class:list={[
            'rounded-pill px-3 py-1.5 text-sm transition-colors',
            l.active
              ? 'bg-accent-soft text-accent font-medium'
              : 'text-ink-2 hover:text-ink hover:bg-muted',
          ]}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={withBase('/search/')}
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink-2 hover:text-ink hover:border-ink-3 transition-colors"
        aria-label="搜索"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M21 21l-4.35-4.35"></path>
        </svg>
      </a>
      <ThemeToggle />
      <button
        id="menu-open"
        type="button"
        class="md:hidden inline-flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink-2"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
