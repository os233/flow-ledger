---
import Header from '@/components/Header.astro';
import MobileDrawer from '@/components/MobileDrawer.astro';
import Footer from '@/components/Footer.astro';
import '../styles/global.css';
import {
  OG_IMAGE_PATH,
  SITE_DESCRIPTION,
  SITE_TITLE,
  canonicalUrl,
  withBase,
} from '@/lib/site';

interface Props {
  /** 页面标题；首页传空字符串使用站点默认标题 */
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** 详情页传文章发布时间，用于 article:published_time */
  publishedTime?: Date;
}

const {
  title = '',
  description = SITE_DESCRIPTION,
  ogType = 'website',
  publishedTime,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} · 先记下，再整理`;
// 调用方可能显式传入空串（如 summary 缺失），空值回落站点默认描述
const desc = description.trim() ? description : SITE_DESCRIPTION;
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase(OG_IMAGE_PATH), Astro.site ?? 'https://example.github.io');
// PR 预览部署设 PUBLIC_NOINDEX=1，避免临时部署的预览内容被搜索引擎收录
const noindex = process.env.PUBLIC_NOINDEX === '1';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={withBase('/rss.xml')}
    />

    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 主题防闪烁：渲染首帧前应用存储或系统的明暗偏好 -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('flow-ledger-theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.classList.toggle('dark', theme === 'dark');
        } catch (e) {
          /* 隐私模式下忽略 */
        }
      })();
    </script>
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="skip-link">跳转到主要内容</a>
    <Header />
    <MobileDrawer />
    <main id="main" class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
