---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const pages = await getCollection('pages');
const about = pages.find((p) => p.id === 'about');
const headings = about ? (await render(about)).headings : [];
const { Content } = about ? await render(about) : { Content: null };
---

<BaseLayout title="关于" description="关于流水账：一个「先记下、再整理、可长期保存」的数字花园。">
  <div class="mx-auto w-full max-w-3xl px-4 sm:px-6 py-10">
    <header class="mb-8 border-b border-line pb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-ink">{about?.data.title ?? '关于'}</h1>
    </header>
    <div class="flex gap-10 flex-col lg:flex-row">
      <div class="min-w-0 flex-1 prose-flow">
        {Content && <Content />}
      </div>
        {
          headings.length > 0 && (
            <div class="lg:w-56 lg:shrink-0 lg:sticky lg:self-start" style="top: calc(var(--header-height) + 1rem)">
              <nav aria-label="目录">
                <h2 class="text-sm font-semibold text-ink-2 mb-2">目录</h2>
                <ul class="space-y-1.5 text-sm border-l border-line">
                  {headings.filter((h) => h.depth === 2).map((h) => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        class="block -ml-px border-l-2 border-transparent pl-3 hover:border-accent hover:text-accent transition-colors text-ink-2"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          )
        }
    </div>
  </div>
</BaseLayout>
