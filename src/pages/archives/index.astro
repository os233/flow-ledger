---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeedCard from '@/components/FeedCard.astro';
import { getVisibleEntries } from '@/lib/content';

const entries = (await getVisibleEntries('archives')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="AI 归档"
  description="与 AI 有价值的对话分享：保留原链接、来源与抓取时间，存档后再整理。"
>
  <div class="mx-auto w-full max-w-3xl px-4 sm:px-6 py-10">
    <header class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-ink">AI 归档</h1>
      <p class="mt-2 text-ink-2">
        与 ChatGPT、Claude、Gemini 等的对话精选，始终保留
        <a class="text-link hover:underline" href="#来源说明">原始链接与抓取时间</a>。
      </p>
    </header>
    <div class="flex flex-col gap-4">
      {entries.map((entry) => <FeedCard entry={entry} />)}
    </div>
  </div>
</BaseLayout>
