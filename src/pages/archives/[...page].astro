---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeedCard from '@/components/FeedCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import Pagination from '@/components/Pagination.astro';
import type { Page, PaginateFunction } from 'astro';
import type { FeedEntry } from '@/lib/content';
import { getVisibleEntries } from '@/lib/content';

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const entries = (await getVisibleEntries('archives')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return paginate(entries, { pageSize: 20 });
}

const { page } = Astro.props as { page: Page<FeedEntry> };
---

<BaseLayout
  title="AI 归档"
  description="与 AI 有价值的对话分享：保留原链接、来源与抓取时间，存档后再整理。"
>
  <div class="mx-auto w-full max-w-3xl px-4 sm:px-6 py-10">
    <header class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-ink">AI 归档</h1>
      <p class="mt-2 text-ink-2">
        与 ChatGPT、Claude、Gemini 等的对话精选，始终保留
        <a class="text-link hover:underline" href="#来源说明">原始链接与抓取时间</a>。
      </p>
    </header>
    {
      page.data.length > 0 ? (
        <div class="flex flex-col gap-4">
          {page.data.map((entry) => <FeedCard entry={entry} />)}
        </div>
      ) : (
        <EmptyState description="第一条对话归档后会出现在这里。" />
      )
    }
    <Pagination page={page} />
    <section
      id="来源说明"
      class="mt-10 scroll-mt-20 rounded-card border border-line bg-muted/50 p-5"
    >
      <h2 class="text-sm font-semibold text-ink-2">来源说明</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-2">
        每条归档都保留原始对话链接（「来源」）、所在平台（如 ChatGPT、Claude、Gemini）、抓取时间与保存格式
        （Markdown 或原始 HTML 快照），便于回溯原文、核对内容完整性；正文为手工整理的存档副本。
      </p>
    </section>
  </div>
</BaseLayout>
