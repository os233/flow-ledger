---
/**
 * 主题切换按钮：auto（跟随系统）→ light → dark 循环。
 * 偏好保存在 localStorage('flow-ledger-theme')，首屏由 BaseLayout
 * 的内联脚本提前应用，避免闪烁。
 */
type Theme = 'auto' | 'light' | 'dark';

const labels: Record<Theme, string> = {
  auto: '跟随系统',
  light: '浅色模式',
  dark: '深色模式',
};
---

<button
  id="theme-toggle"
  type="button"
  class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink-2 hover:text-ink hover:border-ink-3 transition-colors"
  aria-label={`主题：${labels.auto}，点击切换`}
  title={`主题：${labels.auto}`}
>
  <svg class="h-4 w-4 hidden" data-icon="auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none"></path>
  </svg>
  <svg class="h-4 w-4 hidden" data-icon="light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg class="h-4 w-4 hidden" data-icon="dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  type Theme = 'auto' | 'light' | 'dark';
  const ORDER: Theme[] = ['auto', 'light', 'dark'];
  const LABELS: Record<Theme, string> = {
    auto: '跟随系统',
    light: '浅色模式',
    dark: '深色模式',
  };
  const KEY = 'flow-ledger-theme';

  function storedTheme(): Theme {
    const v = localStorage.getItem(KEY);
    return v === 'light' || v === 'dark' || v === 'auto' ? v : 'auto';
  }

  function apply(theme: Theme) {
    const resolved =
      theme === 'auto'
        ? window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light'
        : theme;
    document.documentElement.classList.toggle('dark', resolved === 'dark');
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const icons = btn.querySelectorAll<SVGElement>('[data-icon]');
    icons.forEach((i) => i.classList.toggle('hidden', i.dataset.icon !== theme));
    const label = `主题：${LABELS[theme]}，点击切换`;
    btn.setAttribute('aria-label', label);
    btn.setAttribute('title', label);
  }

  apply(storedTheme());

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = ORDER[(ORDER.indexOf(storedTheme()) + 1) % ORDER.length] as Theme;
    localStorage.setItem(KEY, next);
    apply(next);
  });
</script>
