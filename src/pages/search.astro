---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/site';

const pagefindUiSrc = withBase('/pagefind/pagefind-ui.js');
// Pagefind UI 的样式独立分发，JS 不会自动注入；global.css 的 --pagefind-ui-* 主题令牌也由它消费。
// 通过 head 槽位提前加载，避免样式随脚本在 <body> 内后置加载造成的一瞬跳动。
const pagefindUiCss = withBase('/pagefind/pagefind-ui.css');
---

<BaseLayout
  title="搜索"
  description="全站全文搜索（灵感、归档、项目与博客）。"
  excludeFromSearch
>
  <link rel="stylesheet" href={pagefindUiCss} slot="head" />

  <div class="mx-auto w-full max-w-3xl px-4 sm:px-6 py-10">
    <header class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-ink">搜索</h1>
      <p class="mt-2 text-ink-2">全文检索灵感速记、AI 归档、项目与博客。</p>
    </header>

    <p
      id="search-hint"
      class="hidden rounded-card border border-line bg-muted p-4 text-sm text-ink-2"
    >
      搜索索引尚未就绪：本地开发模式不生成索引。运行
      <code class="rounded bg-raised px-1.5 py-0.5">npm run build && npm run preview</code>
      或访问线上站点使用搜索。
    </p>

    <div id="search"></div>
  </div>

  <script is:inline src={pagefindUiSrc} defer></script>
  <script>
    interface PagefindUICtor {
      new (options: Record<string, unknown>): unknown;
    }
    const el = document.getElementById('search');
    const hint = document.getElementById('search-hint');
    const ctor = (window as unknown as { PagefindUI?: PagefindUICtor }).PagefindUI;
    if (el && ctor) {
      new ctor({
        element: '#search',
        showSubResults: true,
        showImages: false,
        // 界面文案汉化（Pagefind 1.5 Default UI 的键名为 placeholder 等单数形式，
        // 自定义项优先于按页面语言自动加载的内置翻译）
        translations: {
          placeholder: '搜索灵感、归档、项目与博客…',
          clear_search: '清除',
          load_more: '加载更多结果',
          search_label: '搜索本站',
          zero_results: '没有找到与「[SEARCH_TERM]」相关的内容',
          many_results: '共 [COUNT] 条与「[SEARCH_TERM]」相关的结果',
          one_result: '共 [COUNT] 条与「[SEARCH_TERM]」相关的结果',
          searching: '正在搜索「[SEARCH_TERM]」…',
          error_search: '搜索出错，请重试',
          input_hint: '输入时即时显示结果',
        },
      });
      hint?.remove();
      // 从全站快捷键（/ 或 Ctrl+K）跳转而来时，自动聚焦搜索输入框；
      // Pagefind UI 异步挂载，轮询等待输入框出现
      if (new URLSearchParams(window.location.search).has('focus')) {
        let remaining = 20;
        const tryFocus = () => {
          const input = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
          if (input) {
            input.focus();
            return;
          }
          if (remaining-- > 0) setTimeout(tryFocus, 100);
        };
        tryFocus();
      }
    } else {
      hint?.classList.remove('hidden');
    }
  </script>
</BaseLayout>
