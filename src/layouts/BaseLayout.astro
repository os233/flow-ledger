---
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/Header.astro';
import MobileDrawer from '@/components/MobileDrawer.astro';
import Footer from '@/components/Footer.astro';
import '../styles/global.css';
import {
  OG_IMAGE_PATH,
  SITE_DESCRIPTION,
  SITE_TITLE,
  canonicalUrl,
  withBase,
} from '@/lib/site';

interface Props {
  /** 页面标题；首页传空字符串使用站点默认标题 */
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** 详情页传文章发布时间，用于 article:published_time */
  publishedTime?: Date;
  /** 整页排除出 Pagefind 索引（搜索页、404 等自身即工具页的页面） */
  excludeFromSearch?: boolean;
}

const {
  title = '',
  description = SITE_DESCRIPTION,
  ogType = 'website',
  publishedTime,
  excludeFromSearch = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} · 先记下，再整理`;
// 调用方可能显式传入空串（如 summary 缺失），空值回落站点默认描述
const desc = description.trim() ? description : SITE_DESCRIPTION;
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase(OG_IMAGE_PATH), Astro.site ?? 'https://example.github.io');
// PR 预览部署设 PUBLIC_NOINDEX=1，避免临时部署的预览内容被搜索引擎收录
const noindex = process.env.PUBLIC_NOINDEX === '1';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- 客户端导航（View Transitions）：切换页面更连贯，交互脚本需对 swap 安全 -->
    <ClientRouter />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={withBase('/rss.xml')}
    />

    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 页面可向 head 注入资源（如搜索页提前加载 Pagefind 样式） -->
    <slot name="head" />

    <!-- 主题防闪烁：渲染首帧前应用存储或系统的明暗偏好 -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('flow-ledger-theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.classList.toggle('dark', theme === 'dark');
        } catch (e) {
          /* 隐私模式下忽略 */
        }
      })();
    </script>
  </head>
  <body class="min-h-dvh flex flex-col" data-pagefind-ignore={excludeFromSearch ? 'true' : undefined}>
    <a href="#main" class="skip-link">跳转到主要内容</a>
    <Header />
    <MobileDrawer />
    <main id="main" class="flex-1 w-full">
      <slot />
    </main>
    <Footer />

    <script>
      // 本脚本被内联进各页面 HTML，客户端导航会重复执行：
      // 事件注册用 window 标记保证只发生一次（window 在客户端导航间保留）
      const w = window as typeof window & { __flowBaseBound?: boolean };
      if (!w.__flowBaseBound) {
        w.__flowBaseBound = true;

        // 客户端导航 swap 会按新页面的静态 <html> 重置属性，暗色类会丢失，
        // 换页后按存储偏好重放（与首帧防闪烁脚本同一套判定）
        document.addEventListener('astro:after-swap', () => {
          let theme = 'light';
          try {
            const stored = localStorage.getItem('flow-ledger-theme');
            theme =
              stored === 'light' || stored === 'dark'
                ? stored
                : window.matchMedia('(prefers-color-scheme: dark)').matches
                  ? 'dark'
                  : 'light';
          } catch {
            /* 隐私模式下忽略 */
          }
          document.documentElement.classList.toggle('dark', theme === 'dark');
        });

        // 全站搜索快捷键：/ 或 Ctrl/Cmd+K 跳转搜索页并聚焦输入框；已在搜索页时仅聚焦。
        // 焦点在输入控件 / 富文本编辑器内时不抢占（避免干扰打字）。
        const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');

        const openSearch = () => {
          if (window.location.pathname.startsWith(`${BASE}/search`)) {
            document.querySelector<HTMLInputElement>('.pagefind-ui__search-input')?.focus();
            return;
          }
          window.location.href = `${BASE}/search/?focus=1`;
        };

        document.addEventListener('keydown', (e) => {
          if (e.defaultPrevented || e.isComposing) return;
          if (e.key !== '/' && !((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k')) return;
          const target = e.target as HTMLElement | null;
          if (
            target &&
            (target.tagName === 'INPUT' ||
              target.tagName === 'TEXTAREA' ||
              target.tagName === 'SELECT' ||
              target.isContentEditable)
          ) {
            return;
          }
          e.preventDefault();
          openSearch();
        });
      }
    </script>
  </body>
</html>
