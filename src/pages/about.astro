---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Toc from '@/components/Toc.astro';
import CodeCopy from '@/components/CodeCopy.astro';
import { getCollection, render } from 'astro:content';

const pages = await getCollection('pages');
const about = pages.find((p) => p.id === 'about');
// 同一篇内容只 render 一次，同时取正文与标题树
const { Content, headings } = about
  ? await render(about)
  : { Content: null, headings: [] };
const hasToc = headings.some((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout title="关于" description="关于流水账：一个「先记下、再整理、可长期保存」的数字花园。">
  <div class="mx-auto w-full max-w-3xl px-4 sm:px-6 py-10">
    <header class="mb-8 border-b border-line pb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-ink">{about?.data.title ?? '关于'}</h1>
    </header>
    <div class="flex gap-10 flex-col lg:flex-row">
      {
        hasToc && (
          <details
            data-toc-mobile
            class="lg:hidden rounded-card border border-line bg-raised px-4 py-3"
          >
            <summary class="cursor-pointer text-sm font-medium text-ink-2 select-none">
              目录
            </summary>
            <div class="mt-3">
              <Toc headings={headings} />
            </div>
          </details>
        )
      }
      <div class="min-w-0 flex-1 prose-flow">
        {Content && <Content />}
      </div>
        {
          hasToc && (
            <div
              class="hidden lg:block lg:w-56 lg:shrink-0 lg:sticky lg:self-start"
              style="top: calc(var(--header-height) + 1rem)"
            >
              <Toc headings={headings} />
            </div>
          )
        }
    </div>
  </div>
  <CodeCopy />
</BaseLayout>
