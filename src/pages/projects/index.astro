---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { getVisibleEntries } from '@/lib/content';

const entries = (await getVisibleEntries('projects')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
---

<BaseLayout
  title="项目"
  description="我在构建与关注的开源项目：手工说明 + GitHub 实时数据（Stars、Forks、最近更新）。"
>
  <div class="mx-auto w-full max-w-3xl px-4 sm:px-6 py-10">
    <header class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-ink">项目</h1>
      <p class="mt-2 text-ink-2">
        项目卡片的 Stars、Forks 等数据每日由
        <span class="text-ink-3">GitHub Actions</span> 自动刷新缓存。
      </p>
    </header>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {entries.map((entry) => <ProjectCard entry={entry} />)}
    </div>
  </div>
</BaseLayout>
