---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeedCard from '@/components/FeedCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import {
  COLLECTION_LABELS,
  COLLECTION_PATHS,
  getFeedEntries,
  type FeedCollectionName,
} from '@/lib/content';
import { SITE_DESCRIPTION, withBase } from '@/lib/site';

const feed = (await getFeedEntries()).slice(0, 30);

// 时间流只展示最近 30 条，其余内容按类型分列表浏览
const browse = (Object.keys(COLLECTION_LABELS) as FeedCollectionName[]).map((name) => ({
  href: withBase(`/${COLLECTION_PATHS[name]}/`),
  label: COLLECTION_LABELS[name],
}));
---

<BaseLayout description={SITE_DESCRIPTION}>
  <div class="mx-auto w-full max-w-3xl px-4 sm:px-6">
    <section class="py-10 sm:py-14 text-center sm:text-left">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink">
        流水账<span class="text-accent">。</span>
      </h1>
      <p class="mt-3 text-ink-2 leading-relaxed max-w-xl">
        先记下、再整理、可长期保存的数字花园：灵感速记、AI 对话归档、项目动态与博客，共用一套
        Markdown 内容资产。
      </p>
    </section>

    <section aria-label="首页时间流" class="pb-4">
      <h2 class="text-sm font-medium text-ink-3 tracking-wider mb-4">时间流</h2>
      {
        feed.length > 0 ? (
          <div class="flex flex-col gap-4">
            {feed.map((entry) => <FeedCard entry={entry} />)}
          </div>
        ) : (
          <EmptyState description="记下第一条灵感或归档后，这里就会出现时间流。" />
        )
      }
      <div class="mt-8 flex flex-wrap items-center gap-2.5">
        <span class="text-sm text-ink-3">继续逛：</span>
        {
          browse.map((l) => (
            <a
              href={l.href}
              class="rounded-pill border border-line bg-raised px-3.5 py-1.5 text-sm text-ink-2 transition-colors hover:border-accent hover:text-accent"
            >
              {l.label}
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
