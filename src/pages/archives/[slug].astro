---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getCollection } from 'astro:content';
import { isVisible } from '@/lib/content';

export async function getStaticPaths() {
  const entries = await getCollection('archives');
  return entries
    .filter((e) => isVisible(e.data.status))
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const source = {
  url: entry.data.sourceUrl,
  provider: entry.data.provider,
  capturedAt: entry.data.capturedAt,
  format: entry.data.format,
};
---

<ArticleLayout entry={entry} source={source} />
