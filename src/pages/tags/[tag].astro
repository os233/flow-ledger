---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeedCard from '@/components/FeedCard.astro';
import { getFeedEntries } from '@/lib/content';

export async function getStaticPaths() {
  const entries = await getFeedEntries();
  // 按标签一次分组，避免渲染期再调一次 getFeedEntries
  const byTag = new Map<string, typeof entries>();
  for (const e of entries) {
    for (const t of e.data.tags) {
      const list = byTag.get(t) ?? [];
      list.push(e);
      byTag.set(t, list);
    }
  }
  // tag 与 entries 都必须经 props 显式传递：Astro.props 只含 getStaticPaths 传入的 props，
  // 路由参数在 Astro.params 里，混用会导致页面拿到 undefined（所有标签页渲染为空）
  return [...byTag].map(([tag, tagged]) => ({ params: { tag }, props: { tag, entries: tagged } }));
}

const { tag, entries } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`标签 #${tag} 下的全部内容。`}>
  <div class="mx-auto w-full max-w-3xl px-4 sm:px-6 py-10">
    <header class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-ink">#{tag}</h1>
      <p class="mt-2 text-ink-2">共 {entries.length} 条内容。</p>
    </header>
    <div class="flex flex-col gap-4">
      {entries.map((entry) => <FeedCard entry={entry} />)}
    </div>
  </div>
</BaseLayout>
