---
import { isNavActive, withBase } from '@/lib/site';

const links = [
  { href: withBase('/'), label: '首页' },
  { href: withBase('/notes/'), label: '灵感' },
  { href: withBase('/archives/'), label: '归档' },
  { href: withBase('/projects/'), label: '项目' },
  { href: withBase('/posts/'), label: '博客' },
  { href: withBase('/tags/'), label: '标签' },
  { href: withBase('/search/'), label: '搜索' },
  { href: withBase('/about/'), label: '关于' },
];

// 与 Header 共用激活态逻辑，保持两端高亮行为一致
const path = Astro.url.pathname;
const nav = links.map((l) => ({ ...l, active: isNavActive(path, l.href) }));
---

<div
  id="mobile-drawer"
  class="fixed inset-0 z-50 hidden md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="移动端导航菜单"
>
  <div id="drawer-backdrop" class="absolute inset-0 bg-overlay"></div>
  <nav
    id="drawer-panel"
    class="absolute right-0 top-0 flex h-full w-64 max-w-[80vw] flex-col border-l border-line bg-raised p-4 shadow-xl"
    aria-label="移动端导航"
  >
    <div class="flex items-center justify-between mb-4">
      <span class="text-sm font-medium text-ink-3">导航</span>
      <button
        id="menu-close"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-pill border border-line text-ink-2"
        aria-label="关闭菜单"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
    <ul class="flex flex-col gap-1">
      {nav.map((l) => (
        <li>
          <a
            href={l.href}
            aria-current={l.active ? 'page' : undefined}
            class:list={[
              'block rounded-card px-3 py-2.5 transition-colors',
              l.active
                ? 'bg-accent-soft font-medium text-accent'
                : 'text-ink hover:bg-muted hover:text-accent',
            ]}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<script>
  // 无障碍抽屉：打开时焦点移入、Esc / 点击遮罩关闭、Tab 循环限制在抽屉内。
  // 事件全部委托到 document：本模块每次完整加载只执行一次，
  // View Transitions 客户端导航更换 DOM 后依然有效（元素在事件触发时实时查询）。
  function drawerEls() {
    return {
      drawer: document.getElementById('mobile-drawer'),
      openBtn: document.getElementById('menu-open'),
      closeBtn: document.getElementById('menu-close'),
      backdrop: document.getElementById('drawer-backdrop'),
      panel: document.getElementById('drawer-panel'),
    };
  }

  function openDrawer() {
    const { drawer, openBtn, closeBtn, panel } = drawerEls();
    if (!drawer) return;
    drawer.classList.remove('hidden');
    openBtn?.setAttribute('aria-expanded', 'true');
    (closeBtn ?? panel?.querySelector('a'))?.focus();
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    const { drawer, openBtn } = drawerEls();
    if (!drawer) return;
    drawer.classList.add('hidden');
    openBtn?.setAttribute('aria-expanded', 'false');
    openBtn?.focus();
    document.body.style.overflow = '';
  }

  // 事件注册用 window 标记防重复：本脚本会被内联进各页面 HTML，客户端导航会重复执行
  const w = window as typeof window & { __flowDrawerBound?: boolean };
  if (!w.__flowDrawerBound) {
    w.__flowDrawerBound = true;

    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement | null)?.closest?.(
        '#menu-open, #menu-close, #drawer-backdrop',
      );
      if (!target) return;
      if (target.id === 'menu-open') openDrawer();
      else closeDrawer();
    });

    document.addEventListener('keydown', (e) => {
      const { drawer, panel } = drawerEls();
      if (!drawer || drawer.classList.contains('hidden')) return;
      if (e.key === 'Escape') {
        closeDrawer();
        return;
      }
      if (e.key === 'Tab' && panel) {
        const focusables = panel.querySelectorAll<HTMLElement>('a[href], button');
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    // 抽屉打开时窗口拉宽到 md+：抽屉被纯 CSS 隐藏，滚动锁定会残留，主动关闭
    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches) {
        const { drawer } = drawerEls();
        if (drawer && !drawer.classList.contains('hidden')) closeDrawer();
      }
    });
  }
</script>
